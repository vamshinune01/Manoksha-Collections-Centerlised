{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Auth": {
    "Issuer": "manoksha-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SessionAbsoluteDays": 30,
    "MfaRequiredRoles": []
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 20,
    "OtpPermitPerMinute": 10
  }
}
