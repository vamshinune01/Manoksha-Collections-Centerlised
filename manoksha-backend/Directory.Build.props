<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1515/CA1848/CA1062 etc. are noisy for a web app; keep correctness analyzers on. -->
    <NoWarn>$(NoWarn);CA1848;CA1062;CA1515;CA1716;CA1711;CA1724;CA1720;CA1034;CA1056;CA1054;CA1055;CA2227;CA1819;CA1002;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA5394;CA1812;CA1852;CA1822;CA1031;CA1825;CA2000;CA1863;CA1508;CA1861</NoWarn>
  </PropertyGroup>
</Project>
